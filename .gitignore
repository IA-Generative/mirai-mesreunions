# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Claude Code internal scratch (worktrees / agent state — never commit)
.claude/

# Manifests de base zone interne/externe — retirés du repo public.
# Les overlays sous deploy/kubernetes/environments/ référencent ces
# dossiers via des chemins relatifs ; ils doivent être présents localement
# (et synchronisés sur la VM de build hors-git) pour que `kustomize build`
# fonctionne. Voir docs internes pour récupération.
deploy/kubernetes/internal-zone/
deploy/kubernetes/external-zone/

# Environment files
.env
.env.*
!.env.example

# Local Kubernetes secrets (never commit)
deploy/kubernetes/shared/secrets.local.yaml
deploy/kubernetes/shared/secrets.*.local.yaml

# Local helper scripts/env (never commit)
deploy/kubernetes/scripts/*.local.sh
deploy/kubernetes/scripts/*.local.env

# Kubernetes kubeconfigs (NEVER commit — contain cluster CA + user tokens)
deploy/kubernetes/kubeconfigs/*
!deploy/kubernetes/kubeconfigs/.gitkeep
!deploy/kubernetes/kubeconfigs/README.md
*.kubeconfig
.kube/

# Environment-specific local overrides (manifests, env files, sensitive notes)
deploy/kubernetes/environments/**/*.local.yaml
deploy/kubernetes/environments/**/*.local.env
deploy/kubernetes/environments/**/*.local.md
deploy/kubernetes/environments/**/*.local.sh
**/*.local.md

# Audio source & rapports locaux — non versionnés (gros binaires + scratch).
/datasets/
/reports/

# Incident sécurité — local uniquement (contient infra sensible)
INCIDENT_FUITE_*.md
