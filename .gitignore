# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Scratch local d'outils de dev (worktrees / état d'agent — never commit)
.claude/

# Variables d'environnement
.env
.env.*
!.env.example

# Overrides et secrets locaux — jamais committés (convention *.local.*)
*.local.yaml
*.local.yml
*.local.env
*.local.sh
*.local.md

# Kubeconfigs — jamais committés (CA + tokens cluster)
*.kubeconfig
.kube/

# Données locales récupérées hors dépôt par setup.sh, non versionnées
/datasets/
tests/fixtures/audio/

# Fichiers et configuration locaux, non publiés (convention private/ et *.private/)
private/
*.private/
