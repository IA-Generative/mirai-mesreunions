# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Python bytecode / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# IDE
.idea/
.vscode/

# Environment files
.env
.env.*
!.env.example

# Local Kubernetes secrets (never commit)
deploy/kubernetes/shared/secrets.local.yaml
deploy/kubernetes/shared/secrets.*.local.yaml

# Local helper scripts/env (never commit)
deploy/kubernetes/scripts/*.local.sh
deploy/kubernetes/scripts/*.local.env

# Kubernetes kubeconfigs (NEVER commit — contain cluster CA + user tokens)
deploy/kubernetes/kubeconfigs/*
!deploy/kubernetes/kubeconfigs/.gitkeep
!deploy/kubernetes/kubeconfigs/README.md
*.kubeconfig
.kube/

# Environment-specific local overrides
deploy/kubernetes/environments/**/*.local.yaml
deploy/kubernetes/environments/**/*.local.env
